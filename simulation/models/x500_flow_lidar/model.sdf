<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_flow_lidar">
    <include merge="true">
      <uri>model://x500</uri>
    </include>

    <!-- Exact 3D ground-truth odometry publisher for HIL_GPS + logger reference -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/gz/ground_truth/odom</odom_topic>
      <odom_covariance_topic>/gz/ground_truth/odom_cov</odom_covariance_topic>
      <tf_topic>/gz/ground_truth/tf</tf_topic>
    </plugin>

    <!-- Downward Optical Flow Camera + Downward 1D LiDAR mounted under base_link -->
    <link name="flow_lidar_sensor_link">
      <pose relative_to="base_link">0.08 0 -0.04 0 1.57079632679 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>1e-5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-5</iyy>
          <iyz>0</iyz>
          <izz>1e-5</izz>
        </inertia>
      </inertial>

      <!-- Housing placed strictly behind sensor origin (-X in sensor frame = +Z above lens) -->
      <visual name="sensor_housing_visual">
        <pose>-0.025 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.04 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.14 1</ambient>
          <diffuse>0.18 0.18 0.20 1</diffuse>
        </material>
      </visual>

      <sensor name="downward_flow_cam" type="camera">
        <pose>0.01 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>/gz/downward_camera/image</topic>
        <camera>
          <horizontal_fov>0.80</horizontal_fov>
          <image>
            <width>128</width>
            <height>128</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100.0</far>
          </clip>
        </camera>
      </sensor>

      <sensor name="downward_lidar" type="gpu_lidar">
        <pose>0.01 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>/gz/downward_lidar/scan</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>60.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <joint name="flow_lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>flow_lidar_sensor_link</child>
    </joint>
  </model>
</sdf>
